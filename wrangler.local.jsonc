{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sui-task-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-06",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/auth/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "sui-task-db", "database_id": "REPLACE_AFTER_D1_CREATE", "migrations_dir": "migrations" }],
  "vars": { "APP_ORIGIN": "http://127.0.0.1:5173" }
}
