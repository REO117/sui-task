{
  "name": "sui-task",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "wrangler dev --config wrangler.local.jsonc --port 8787",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply sui-task-db --local",
    "db:remote": "wrangler d1 migrations apply sui-task-db --remote"
  },
  "dependencies": {
    "dexie": "4.4.7",
    "dexie-react-hooks": "4.4.0",
    "hono": "4.13.16",
    "jose": "6.2.15",
    "lucide-react": "1.69.0",
    "motion": "14.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "fake-indexeddb": "6.2.7",
    "miniflare": "5.20261104.0-beta",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.0",
    "wrangler": "4.158.0"
  }
}
