{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sui-task",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-06",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/auth/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "sui-task-db", "database_id": "22d32b30-2293-4b81-8ab5-9b23de78ce95", "migrations_dir": "migrations" }],
  "ai": { "binding": "AI" },
  "vars": { "AI_MODEL": "@cf/openai/gpt-oss-20b", "APP_ORIGIN": "https://sui-task.saymyname710.workers.dev" },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
